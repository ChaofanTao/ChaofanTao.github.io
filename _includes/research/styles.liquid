{% include site/mobile-nav.liquid %}
<style>
  .research-page {
    --research-muted: #59616b;
    max-width: 52rem;
    margin: 0 auto;
    padding-bottom: 2rem;
    line-height: 1.7;
  }

  html[data-theme="dark"] .research-page {
    --research-muted: #b5bdc8;
  }

  .research-page :is(section, h2, [id]) {
    scroll-margin-top: 5.5rem;
  }

  .research-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
    color: var(--research-muted);
    font-size: 0.85rem;
  }

  .research-breadcrumb a {
    color: inherit;
  }

  .research-page h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.6rem, 6vw, 2.3rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .research-meta {
    margin: 0 0 1.5rem;
    color: var(--research-muted);
    font-size: 0.88rem;
  }

  .research-lead {
    font-size: 1.08rem;
  }

  .research-page h2 {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .research-page h3 {
    margin: 1.25rem 0 0.4rem;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .research-table-wrap {
    overflow-x: auto;
    margin: 1rem 0;
  }

  .research-page table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .research-page th,
  .research-page td {
    padding: 0.55rem 0.6rem;
    border-bottom: 1px solid var(--global-divider-color);
    text-align: left;
    vertical-align: top;
  }

  .research-page th {
    font-weight: 600;
    white-space: nowrap;
  }

  .research-page blockquote {
    margin: 1.25rem 0;
    padding: 0.6rem 1rem;
    border-left: 3px solid var(--global-theme-color);
    color: var(--research-muted);
  }

  .research-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .research-card {
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 0.5rem;
  }

  .research-card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }

  .research-card p {
    margin: 0;
    font-size: 0.92rem;
  }

  .research-toc {
    margin: 1rem 0 0.5rem;
    color: var(--research-muted);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .research-toc a {
    white-space: nowrap;
  }

  .research-knowhow {
    margin: 0.6rem 0 0.4rem;
    padding: 0.7rem 1rem 0.7rem 2rem;
    border-left: 3px solid var(--global-theme-color);
    background: var(--global-code-bg-color);
    border-radius: 0 0.4rem 0.4rem 0;
    font-size: 0.95rem;
  }

  .research-knowhow li {
    margin: 0.25rem 0;
  }

  .research-knowhow-label {
    margin: 0.9rem 0 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--research-muted);
  }

  .research-readmore {
    margin-top: 0.5rem;
    font-size: 0.88rem;
  }

  .research-dek {
    margin: -0.25rem 0 0.75rem;
    color: var(--research-muted);
    font-size: 1.1rem;
    line-height: 1.55;
  }

  .research-figure {
    margin: 1.75rem 0;
  }

  .research-figure-scroll {
    overflow-x: auto;
  }

  .research-figure img {
    display: block;
    width: 100%;
    min-width: 620px;
    height: auto;
  }

  .research-figure figcaption {
    margin-top: 0.5rem;
    color: var(--research-muted);
    font-size: 0.86rem;
  }

  .research-insights {
    padding-left: 1.2rem;
  }

  .research-insights li {
    margin-bottom: 0.9rem;
  }

  .research-more {
    margin: 1rem 0;
    padding: 0.7rem 1rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 0.4rem;
  }

  .research-more > summary {
    cursor: pointer;
    font-weight: 600;
  }

  .research-more[open] > summary {
    margin-bottom: 0.75rem;
  }

  .research-papers {
    padding-left: 1.2rem;
  }

  .research-paper {
    margin-bottom: 1.1rem;
  }

  .research-paper h3 {
    margin: 0;
    font-size: 1rem;
  }

  .research-paper p {
    margin: 0.15rem 0;
    font-size: 0.9rem;
  }

  .research-paper-meta {
    color: var(--research-muted);
  }

  .research-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.85rem;
  }

  .research-page pre {
    overflow-x: auto;
    padding: 0.8rem 1rem;
    border-radius: 0.4rem;
    background: var(--global-code-bg-color);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .research-cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
