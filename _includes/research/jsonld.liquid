{% comment %}
  Page-level JSON-LD for research pages. Reads page.title, page.description, page.about
  and page.research_lang. With include.group the page is an Article that cites that
  publication group from _data/homepage.json; without it, a CollectionPage hub.
{% endcomment %}
{% assign page_url = page.url | prepend: site.url %}
{% assign person_id = site.url | append: '/#person' %}
{% assign research_url = '/research/' | prepend: site.url %}
{% if page.research_lang == 'zh' %}{% assign research_url = '/zh/research/' | prepend: site.url %}{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "{% if include.group %}Article{% else %}CollectionPage{% endif %}",
      "@id": "{{ page_url }}#page",
      "url": "{{ page_url }}",
      "mainEntityOfPage": "{{ page_url }}",
      {% if include.group %}"headline": {{ page.title | jsonify }},{% endif %}
      "name": {{ page.title | jsonify }},
      "description": {{ page.description | jsonify }},
      "inLanguage": "{% if page.research_lang == 'zh' %}zh-Hans{% else %}en{% endif %}",
      "datePublished": "2026-11-03",
      "dateModified": "{{ page.last_modified_at | date: '%Y-%m-%d' }}",
      {% if page.figure %}"image": "{{ site.url }}{{ page.figure }}",{% endif %}
      "isPartOf": { "@id": "{{ site.url }}/#website" },
      "author": { "@id": "{{ person_id }}" },
      "about": [{% for subject in page.about %}{ "@type": "Thing", "name": {{ subject | jsonify }} }{% unless forloop.last %}, {% endunless %}{% endfor %}],
      "breadcrumb": { "@id": "{{ page_url }}#breadcrumb" }{% if include.group %},
      {% assign group_papers = site.data.homepage.publications | where: "group", include.group %}
      "citation": [{% for paper in group_papers %}{ "@type": "ScholarlyArticle", "@id": {{ paper.url | jsonify }}, "headline": {{ paper.title | jsonify }}, "author": { "@id": "{{ person_id }}" } }{% unless forloop.last %}, {% endunless %}{% endfor %}]{% endif %}
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{ page_url }}#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Chaofan Tao", "item": "{{ site.url }}/" }{% if page_url != research_url %},
        { "@type": "ListItem", "position": 2, "name": {% if page.research_lang == 'zh' %}"研究"{% else %}"Research"{% endif %}, "item": "{{ research_url }}" },
        { "@type": "ListItem", "position": 3, "name": {{ page.title | jsonify }}, "item": "{{ page_url }}" }{% else %},
        { "@type": "ListItem", "position": 2, "name": {{ page.title | jsonify }}, "item": "{{ page_url }}" }{% endif %}
      ]
    }
  ]
}
</script>
