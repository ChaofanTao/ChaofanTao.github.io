<script>
  // The theme's `.collapse { display: none !important }` lives in a Tailwind cascade layer,
  // which outranks unlayered !important rules, so the class is removed instead of overridden.
  (function () {
    var nav = document.getElementById("navbar");
    var menu = document.getElementById("navbarNav");
    if (!nav || !menu) return;
    menu.classList.remove("collapse");
    nav.classList.add("nav-always-open");
  })();
</script>
<style>
  /* Keep the navbar expanded on small screens instead of hiding it behind the toggle. */
  @media (max-width: 575.98px) {
    #navbar.nav-always-open .navbar-toggler-main {
      display: none !important;
    }

    #navbar.nav-always-open {
      padding-right: 0;
      padding-left: 0;
    }

    #navbar.nav-always-open > .container {
      flex-wrap: nowrap;
      gap: 0.5rem;
      padding-right: 0.4rem;
      padding-left: 0.6rem;
    }

    #navbar.nav-always-open .navbar-brand {
      flex: 0 0 auto;
      margin-right: 0;
      font-size: 1rem;
      white-space: nowrap;
    }

    #navbar.nav-always-open .navbar-collapse-main {
      display: flex !important;
      flex: 1 1 auto;
      flex-basis: auto;
      min-width: 0;
      width: auto;
      margin: 0;
      padding: 0;
      justify-content: flex-end;
    }

    #navbar.nav-always-open .navbar-menu-list {
      flex-direction: row !important;
      flex-wrap: nowrap;
      align-items: center;
      margin: 0;
      padding: 0;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    #navbar.nav-always-open .navbar-menu-list::-webkit-scrollbar {
      display: none;
    }

    #navbar.nav-always-open .navbar-menu-list > li {
      flex: 0 0 auto;
    }

    /* Pages with a site title: title on the left, links and theme toggle on the right. */
    #navbar.nav-always-open .navbar-brand ~ .navbar-collapse-main {
      margin-left: auto;
    }

    #navbar.nav-always-open .navbar-brand ~ .navbar-collapse-main .navbar-menu-list {
      width: 100%;
      justify-content: flex-end;
    }

    /* Homepage (no site title): spread the links across the full width. */
    #navbar.nav-always-open .navbar-toggler-main:first-child ~ .navbar-collapse-main,
    #navbar.nav-always-open .navbar-toggler-main:first-child ~ .navbar-collapse-main .navbar-menu-list {
      width: 100%;
    }

    #navbar.nav-always-open .navbar-toggler-main:first-child ~ .navbar-collapse-main .navbar-menu-list {
      justify-content: space-between;
    }

    #navbar.nav-always-open .navbar-menu-list .nav-link {
      padding: 0.45rem 0.3rem;
      font-size: 0.84rem;
      white-space: nowrap;
    }

    #navbar.nav-always-open .toggle-container {
      margin-left: 0.1rem;
    }

    #navbar.nav-always-open #light-toggle {
      padding-right: 0.2rem;
      padding-left: 0.2rem;
    }
  }
</style>
